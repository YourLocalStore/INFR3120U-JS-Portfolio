<!DOCTYPE html>
<html>
  
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/fontawesome.min.css">
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css'/>
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' href='/stylesheets/media.css' />

    <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>
  </head>

  <%- include("../reusables/header.ejs") %>
  <body>
    <div class="project-container container-fluid pt-2">

      <div class="row">
        <div class="col-12 col-md-8 col-lg-6 w-100 mx-auto">
          <div class="card bg-dark text-white mb-3 pt-3 text-center">
            <div class="card-body">
              <div class="card-title">
                <h1><%= title %>!</h1>
                <p>Welcome to <%= title %></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row text-start">

        <div class="col-12 col-xl-4 col-md-12 col-lg-6 pb-2 w-45">
          <div class="card bg-dark text-white" style="height:425px">
            <div class="card-body">
              <img class="card-img-top" 
                    style="height:224px; object-fit: cover;" src="images/homelab.png" alt="">
              <div class="card-title pt-3">
                <h4>Homelab</h4>
              </div class>
      
              <div class="card-text fs-6">
                <p>2026 - Present</p>
                <hr>
              </div>

              <div class="card-text fs-6 text-end">
                <p>Docker, Ubuntu Server</p>
              </div>

            </div>
          </div>
          <a href="homelab" class="btn btn-primary">See More!</a>
        </div>

        <div class="col-12 col-xl-4 col-md-12 col-lg-6 pb-2 w-45">
          <div class="card bg-dark text-white" style="height:425px">
            <div class="card-body">
              <img class="card-img-top" style="height:224px; object-fit: contain;" src="images/socket.png" alt="">

              <div class="card-title pt-3">
                <h4>Multithreaded Sockets</h4>
              </div class>
      
              <div class="card-text fs-6">
                <p>2026</p>
                <hr>
              </div>
              <div class="card-text fs-6 text-end">
                <p>Python</p>
              </div>

            </div>
          </div>
          <a href="/multithread" class="btn btn-primary">See More!</a>
        </div>       

        <div class="col-12 col-xl-4 col-md-12 col-lg-6 pb-2 w-45">
          <div class="card bg-dark text-white" style="height:425px">
            <div class="card-body">
              <img class="card-img-top" style="height:224px; object-fit: contain;" src="images/sms.png" alt="">

              <div class="card-title pt-3">
                <h4>Student Management System</h4>
              </div class>
      
              <div class="card-text fs-6">
                <p>2025</p>
                <hr>
              </div>
              <div class="card-text fs-6 text-end">
                <p>Python, SQL</p>
              </div>
              
            </div>
          </div>
          <a href="sms" class="btn btn-primary">See More!</a>
        </div>

        <div class="col-12 col-xl-4 col-md-12 col-lg-6 pb-2 w-45">
          <div class="card bg-dark text-white" style="height:425px">
            <div class="card-body">
              <img class="card-img-top" 
                   style="height:224px; object-fit: contain;" src="images/packet.png" alt="">

              <div class="card-title pt-3">
                <h4>Designing Networks</h4>
              </div class>
      
              <div class="card-text fs-6">
                <p>2025</p>
                <hr>
              </div>
              <div class="card-text fs-6 text-end">
                <p>Packet Tracer</p>
              </div>

            </div>
          </div>
          <a href="/pktracer" class="btn btn-primary">See More!</a>
        </div>

        <div class="col-12 col-xl-4 col-md-12 col-lg-6 pb-2 w-45">
          <div class="card bg-dark text-white" style="height:425px">
            <div class="card-body">
              <img class="card-img-top" 
                   style="height:224px; object-fit: contain;" src="images/fib.png" alt="">

              <div class="card-title pt-3">
                <h4>Fibonacci Sequence</h4>
              </div class>
  
              <div class="card-text fs-6">
                <p>2025</p>
                <hr>
              </div> 
              <div class="card-text fs-6 text-end">
                <p>RISC-V</p>
              </div>  

            </div>
          </div>
          <a href="/fibonacci" class="btn btn-primary">See More!</a>
        </div>

        <div class="col-12 col-xl-4 col-md-12 col-lg-6 pb-2 w-45">
          <div class="card bg-dark text-white" style="height:425px">
            <div class="card-body">
              <img class="card-img-top" 
                   style="height:224px; object-fit: cover;" src="images/rcs_plus.png" alt="">

              <div class="card-title pt-3">
                <h4>RhythmCS</h4>
              </div class>
      
              <div class="card-text fs-6">
                <p>2020 - 2024</p>
                <hr>
              </div>
              <div class="card-text fs-6 text-end">
                <p>LUAU, Python</p>
              </div> 

            </div>
          </div>
          <a href="/rcs" class="btn btn-primary">See More!</a>
        </div>
      </div>
    </div>
  </body>
  <%- include("../reusables/footer.ejs") %>
  
</html>
