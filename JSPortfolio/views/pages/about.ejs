<!DOCTYPE html>
<html>
  
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/fontawesome.min.css">
    <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css'/>
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' href='/stylesheets/media.css' />    

    <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>
  </head>

  <%- include("../reusables/header.ejs") %>
  <body>

    <div class="container-fluid pt-4 text-start">
      
      <div class ="row">
        <div class="col-12 col-md-8 col-lg-6 w-100">
          <div class="card bg-dark text-white mb-3">
            <div class="card-body">
              <div class="card-title">
                <h1><%= title %>!</h1>
                <p>Welcome to <%= title %></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-12 col-md-8 col-lg-6 pb-4 w-45">
          <div class="card bg-secondary text-white mb-3" style="height:400px">
            <div class="card-body">
              <div class="card-title">
                <h1>Hello!</h1>
                <p>THIS IS SOME PLACEHOLDER TEXT!!!</p>
              </div class>

              <div class="card-text fs-6">
                <p>THIS IS PLACEHOLDER TEXT!!</p>
                <p>THIS IS PLACEHOLDER TEXT!!</p>
              </div>
            </div>
          </div>
        </div>
          
        <div class="col-12 col-md-8 col-lg-6 pb-4 w-45">
          <div class="card bg-secondary text-white mb-3" style="height:400px">
            <div class="card-body">
              <img class="card-img-top" style="height:14rem; object-fit: cover;" src="images/placeholder.jpg" alt="">
              <div class="card-title pt-3">
                <h4>Hello!</h4>
              </div class>

              <div class="card-text fs-6">
                <p>THIS IS PLACEHOLDER TEXT!!</p>
                <p>THIS IS PLACEHOLDER TEXT!!</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </div>

  </body>
  <%- include("../reusables/footer.ejs") %>
  
</html>
