<!DOCTYPE html>
<html>
  
  <head>
    <link rel="stylesheet" href="/fontawesome-free-7.3.1-web/css/fontawesome.min.css">
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/bootstrap/dist/css/bootstrap.min.css'/>
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' href='/stylesheets/media.css' />

    <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>

  </head>

  <%- include("../reusables/header.ejs") %>
  <body>
    <!-- 1st Section: Welcome -->
    <div id="welcome-section">
      <section class="bg-dark text-center">
        <div class="container-fluid">

          <img class="banner-img" src="/images/home_banner_placeholder.png" alt="...">

          <div class="row">
            <div class="welcome-text col pt-5 pb-5">
              <h1><%= title %> Tuibuen</h1>
              <p>Networking and IT Security Student</p>
            </div>
          </div>

          <div class="welcome-sig">
            <img src="images/jt_sig2.png" alt="..." >
          </div>

        </div>
      </section>
    </div>

    <!-- 2nd Section: *Brief* About Me -->
    <div id="about-me">
      <section class="bg-light py-4 ps-sm-1">
        <div class="container-fluid">
          <div class="row">

            <!-- The decimal widths are chosen arbitrarily for two gaps in the middle to
                 seem "even"-->
            <div class="col text-end" id="card-left-of-jt">
              <div class="card bg-transparent text-white card-test" 
                   style="width:90%; height:465px; border: none">

                <div class="card-body">
                  <h1 class="card-title fs-1">> Hello...</h1>
                  <div class="card-text">
                    <p>World!</p>
                  </div>
                </div>
              </div>
            </div>
          
            <div class="col text-start" id="card-right-of-jt">
              <div class="card bg-transparent text-white ms-auto card-test" 
                   style="width:90%; height:465px; border: none">
                <div class="card-body">
                  <h1 class="card-title fs-1">Welcome <</h1>
                  <div class="card-text">
                    <p>To my Portfolio!</p>
                  </div>
                </div>
              </div>
            </div>

            <div id="jt-image">
              <img src="/images/jt_about.png" alt="..." class="mx-auto">
            </div>

          </div>


        </div>
      </section>
    </div>

    <!-- 3rd Section: Projects -->
    <div id="projects">
      <section class="bg-light py-2 ps-1">
        <div class="container-fluid">

          <div class="row w-100">
            <div class="col-12 col-md-6 pb-4">
              <div class="project-home-header">
                <div class="container-fluid pt-2 text-center">
                  <h2>My Projects</h2>
                  <p>Here are some of my projects!</p>
                </div>
              </div>
              
              <div class="col-12 text-center">
                <div id="index-carousel" class="carousel carousel-dark slide">
                  <div class="carousel-indicators" style="bottom:-30px;">
                    <button type="button" 
                            data-bs-target="#index-carousel" 
                            data-bs-slide-to="0" 
                            class="active" 
                            aria-current="true" aria-label="Slide 1">
                    </button>

                    <button type="button" 
                            data-bs-target="#index-carousel" 
                            data-bs-slide-to="1" 
                            aria-label="Slide 2">
                    </button>

                    <button type="button" 
                            data-bs-target="#index-carousel" 
                            data-bs-slide-to="2" 
                            aria-label="Slide 3">
                    </button>
                  </div>

                  <div class="carousel-inner">
                    <div class="carousel-item active" data-bs-interval="10000">
                      <div class="col-12 text-center py-2">
                        <div class="card bg-secondary text-white">
                          <img class="card-img-top" 
                               style="height:224px; object-fit: cover;" 
                               src="images/placeholder.jpg" alt="">
                          <div class="card-body">
                            <h4 class="card-title">Student Management System</h4>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="carousel-item" data-bs-interval="2000">
                      <div class="col-12 text-center py-2">
                        <div class="card bg-secondary text-white">
                          <img class="card-img-top" 
                               style="height:224px; object-fit: cover" 
                               src="images/placeholder.jpg" alt="">
                          <div class="card-body">
                            <h4 class="card-title">Multithreaded Sockets</h4>
                          </div>
                        </div>
                      </div>                     
                    </div>

                    <div class="carousel-item">
                      <div class="col-12 text-center py-2">
                        <div class="card bg-secondary text-white">
                          <img class="card-img-top" 
                               style="height:224px; object-fit: cover" 
                               src="images/placeholder.jpg" alt="">
                          <div class="card-body">
                            <h4 class="card-title">Designing Networks</h4>
                          </div>
                        </div>
                      </div>                      
                    </div>
                  </div>

                  <button class="carousel-control-prev" 
                          type="button" 
                          data-bs-target="#index-carousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                  </button>

                  <button class="carousel-control-next" 
                          type="button" 
                          data-bs-target="#index-carousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                  </button>
                
                </div>

                <div class="col-12 mt-3 text-center">
                  <a href="/projects" class="btn btn-dark">Click to see more of my projects!</a>
                </div>

              </div>
            </div>
            
            <div class="col-12 col-md-6 pb-4">
              <div class="project-home-header">
                <div class="container-fluid pt-2 text-center">
                  <h2>About Me</h2>
                  <p>Want to learn more?</p>
                </div>
              </div>

              <div class="col-12 text-center">
                <div id="index-about-carousel" class="carousel carousel-dark slide">
                  <div class="carousel-indicators" style="bottom:-30px;">
                    <button type="button" 
                            data-bs-target="#index-about-carousel" data-bs-slide-to="0" 
                            class="active" 
                            aria-current="true" aria-label="Slide 1">
                    </button>
              
                    <button type="button" 
                            data-bs-target="#index-about-carousel" 
                            data-bs-slide-to="1" 
                            aria-label="Slide 2">
                    </button>
              
                    <button type="button" 
                            data-bs-target="#index-about-carousel" data-bs-slide-to="2" 
                            aria-label="Slide 3">
                    </button>
                  </div>
              
                  <div class="carousel-inner">
                    <div class="carousel-item active" data-bs-interval="10000">
                      <div class="col-12 text-center py-2">
                        <div class="card bg-secondary text-white">
                          <img class="card-img-top" 
                               style="height:224px; object-fit: cover;" 
                               src="images/placeholder.jpg" alt="">
                          <div class="card-body">
                            <h4 class="card-title">Something</h4>
                          </div>
                        </div>
                      </div>
                    </div>
              
                    <div class="carousel-item" data-bs-interval="2000">
                      <div class="col-12 text-center py-2">
                        <div class="card bg-secondary text-white">
                          <img class="card-img-top" 
                               style="height:224px; object-fit: cover" 
                               src="images/placeholder.jpg" alt="">
                          <div class="card-body">
                            <h4 class="card-title">Something</h4>
                          </div>
                        </div>
                      </div>
                    </div>
              
                    <div class="carousel-item">
                      <div class="col-12 text-center py-2">
                        <div class="card bg-secondary text-white">
                          <img class="card-img-top" 
                               style="height:224px; object-fit: cover" 
                               src="images/placeholder.jpg" alt="">
                          <div class="card-body">
                            <h4 class="card-title">Something</h4>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
              
                  <button class="carousel-control-prev" 
                          type="button" 
                          data-bs-target="#index-about-carousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                  </button>
              
                  <button class="carousel-control-next" 
                          type="button" 
                          data-bs-target="#index-about-carousel" 
                          data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                  </button>
              
                </div>

                <div class="col-12 mt-3 text-center">
                  <a href="/about" class="btn btn-dark">Click to see more about me!</a>
                </div>

              </div>
            </div>

          </div>

        </div>
      </section>
    </div>

  </body>
  <%- include("../reusables/footer.ejs") %>
  
</html>
